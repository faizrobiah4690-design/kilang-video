# Tetapan Persekitaran Kilang Pemasaran (salin ke `.env` untuk kegunaan tempatan; JANGAN commit `.env`)
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-3.8-flash

# Pilihan — hanya diperlukan jika guna mod Video Stok (Pexels / Pixabay) atau Google Flow UseAPI
PEXELS_API_KEY=
PIXABAY_API_KEY=
USEAPI_TOKEN=

# Tetapan pelayan WebUI
PORT=8501
